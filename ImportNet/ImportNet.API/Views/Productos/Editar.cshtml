@model ImportNet.API.Models.ProductoForm
@{ ViewData["Title"] = Model.Id == 0 ? "Crear producto" : "Editar producto"; }
<h1 class="mb-4">@ViewData["Title"]</h1>
<form method="post" action="/productos/guardar" class="card shadow-sm p-4">
@Html.AntiForgeryToken()
<input asp-for="Id" type="hidden"/>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Codigo" class="form-label">Código</label><input asp-for="Codigo" type="text"  class="form-control"/><span asp-validation-for="Codigo" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" type="text"  class="form-control"/><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Descripcion" class="form-label">Descripción</label><input asp-for="Descripcion" type="text"  class="form-control"/><span asp-validation-for="Descripcion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="UnidadMedida" class="form-label">Unidad de medida</label><input asp-for="UnidadMedida" type="text"  class="form-control"/><span asp-validation-for="UnidadMedida" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Peso" class="form-label">Peso (kg, opcional)</label><input asp-for="Peso" type="number" step="0.001" min="0.001" class="form-control"/><span asp-validation-for="Peso" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="PrecioVenta" class="form-label">Precio de venta (S/)</label><input asp-for="PrecioVenta" type="number" step="0.01" min="0" class="form-control"/><span asp-validation-for="PrecioVenta" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="PartidaArancelaria" class="form-label">Partida arancelaria (opcional)</label><input asp-for="PartidaArancelaria" type="text"  class="form-control"/><span asp-validation-for="PartidaArancelaria" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="StockMinimo" class="form-label">Stock mínimo</label><input asp-for="StockMinimo" type="number" step="0.001" min="0" class="form-control"/><span asp-validation-for="StockMinimo" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CategoriaId" class="form-label">Categoría</label>
<select asp-for="CategoriaId" class="form-select"><option value="">Seleccione una categoría</option>
@foreach (var categoria in Model.Categorias) { <option value="@categoria.Id">@categoria.Nombre</option> }
</select><span asp-validation-for="CategoriaId" class="text-danger"></span></div></div>
<div class="mt-4"><button type="submit" class="btn btn-primary">Guardar</button> <a href="/productos" class="btn btn-outline-secondary">Volver</a></div>
</form>
