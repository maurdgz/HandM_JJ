@model IReadOnlyList<ImportNet.Domain.Entities.Producto>
@{ ViewData["Title"] = "Productos"; var editar = User.IsInRole("Administrador"); }
<div class="d-flex justify-content-between align-items-center mb-4"><h1>Productos</h1>
@if (editar) { <a class="btn btn-primary" href="/productos/crear">Crear producto</a> }</div>
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0">
<thead><tr><th>Nombre</th><th>Código</th><th>Precio USD</th><th>Categoría</th><th>Acciones</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.Nombre</td><td>@item.Codigo</td><td>@item.PrecioUsd.ToString("F2")</td><td>@item.CategoriaId</td><td>
    @if (editar) {
        <a class="btn btn-outline-primary btn-sm" href="/productos/@item.Id/editar">Editar</a>
        <form method="post" action="/productos/@item.Id/eliminar" class="d-inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger btn-sm" type="submit">Eliminar</button>
        </form>
    }
    </td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5" class="text-secondary py-4">No hay registros. Cree el primero para comenzar.</td></tr> }
</tbody></table></div></div>
