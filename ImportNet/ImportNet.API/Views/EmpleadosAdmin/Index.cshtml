@model ImportNet.API.Models.EmpleadoListado
@{ ViewData["Title"] = "Empleados"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1>Empleados</h1><p class="text-secondary">Cuentas, perfiles y permisos del equipo.</p></div>
    <a class="btn btn-primary" href="/empleados/crear">Registrar empleado</a>
</div>
<form method="get" action="/empleados" class="row g-2 mb-4">
    <div class="col-md-7"><label for="busqueda" class="visually-hidden">Buscar</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Nombre, apellido, documento o correo" maxlength="100"/></div>
    <div class="col-md-3"><label for="activo" class="visually-hidden">Estado</label><select id="activo" name="activo" class="form-select">
        <option value="">Todos los estados</option><option value="true" selected="@(Model.Activo == true)">Activos</option><option value="false" selected="@(Model.Activo == false)">Inactivos</option>
    </select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Buscar</button></div>
</form>
<div class="card shadow-sm table-responsive"><table class="table align-middle mb-0">
<thead><tr><th>Empleado</th><th>Documento / contacto</th><th>Cargo / área</th><th>Roles</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach (var e in Model.Empleados)
{
    <tr><td>@e.Nombre @e.Apellidos</td><td>@(e.DocumentoIdentidad ?? "Perfil por completar")<br/><small>@e.Email<br/>@e.Telefono</small></td>
    <td>@e.Cargo<br/><small>@e.Area</small></td><td>@string.Join(", ", e.Roles)</td>
    <td><span class="badge @(e.Activo ? "text-bg-success" : "text-bg-secondary")">@(e.Activo ? "Activo" : "Inactivo")</span></td>
    <td><a class="btn btn-sm btn-outline-primary mb-1" href="/empleados/@e.Id/editar">Editar</a>
    <form method="post" action="/empleados/@e.Id/estado" class="d-inline">@Html.AntiForgeryToken()
        <input type="hidden" name="activo" value="@((!e.Activo).ToString().ToLowerInvariant())"/>
        <button class="btn btn-sm btn-outline-secondary mb-1">@(e.Activo ? "Desactivar" : "Activar")</button>
    </form></td></tr>
}
@if (Model.Empleados.Count == 0) { <tr><td colspan="6" class="text-secondary py-4">No se encontraron empleados.</td></tr> }
</tbody></table></div>
